	common/ppa_ntfs.o \
	common/ppa_vfs.o \
	common/libyal_psp_compat.o \
	mod/me_boot_start.o \
	mod/audio_format.o \
	mod/audio_software.o \
	mod/audio_stream.o \
	mod/audio_pcm_vfpu.o \
	mod/audio_src_core.o \
