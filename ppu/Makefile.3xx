PSPSDK := $(shell psp-config --pspsdk-path)
PSPLIBSDIR := $(PSPSDK)/..
PSPM33SDKDIR := $(PSPLIBSDIR)/m33-sdk

BUILD_PRX = 1
PSP_FW_VERSION ?= 660
PSP_LARGE_MEMORY = 1

TARGET = PPU
OBJS = main.o \
